# ==============================================================================
# ListenUp Backend Environment Variables Template
# ==============================================================================
# Copy this file to '.env' in the backend/ directory:
#   cp .env.example .env
#
# Server Port Configuration (defaults to 5001 if omitted)
PORT=5001

# Supabase Authentication & Server-Side Verification
# Obtain these values from your Supabase Dashboard -> Project Settings -> API:
#   - SUPABASE_URL: Project URL (e.g. https://your-project-id.supabase.co)
#   - SUPABASE_JWT_SECRET: JWT Secret used for cryptographic signature verification
#   - SUPABASE_ANON_KEY: Publishable anon client key for REST queries
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-from-dashboard
SUPABASE_ANON_KEY=your-publishable-anon-key
